# Uygulamanın veri adresi (GitHub Pages, saatte bir güncellenir). EXPO_PUBLIC_ değişkenleri uygulamaya gömülür, gizli değildir.
# Yerel veri sunucusuyla (npm run serve -w @oran/pipeline) denemek için .env.local dosyasına
# EXPO_PUBLIC_DATA_BASE_URL=http://<bilgisayarın IP'si>:8090 yazın; .env.local git'e girmez.
EXPO_PUBLIC_DATA_BASE_URL=https://omercnsz.github.io/oran-motoru
# Canlı skorlar için ESPN önbelleği (Cloudflare Worker). Ulaşılamazsa uygulama ESPN'e doğrudan bağlanır.
EXPO_PUBLIC_LIVE_URL=https://oran-canli.oran-worker.workers.dev
