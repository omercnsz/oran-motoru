{
  "expo": {
    "name": "Oran",
    "slug": "oran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oran",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/oran.icon",
      "bundleIdentifier": "com.omercnsz.oran",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7C55",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.omercnsz.oran",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C55",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "tr",
            "es",
            "pt",
            "ar",
            "ru",
            "de",
            "fr",
            "it",
            "nl",
            "pl",
            "ro",
            "el",
            "sr",
            "hr",
            "bs",
            "sq",
            "bg",
            "mk",
            "sl",
            "zh",
            "ja",
            "ko",
            "id",
            "vi",
            "th",
            "hi"
          ]
        }
      ],
      "./plugins/without-push-entitlement.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0E7C55"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "./plugins/google-mobile-ads-gradle-fix.js",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Inter_400Regular.ttf",
              "./assets/fonts/Inter_500Medium.ttf",
              "./assets/fonts/Inter_600SemiBold.ttf",
              "./assets/fonts/Inter_700Bold.ttf",
              "./assets/fonts/Inter_800ExtraBold.ttf",
              "./assets/fonts/Unbounded_500Medium.ttf",
              "./assets/fonts/Unbounded_700Bold.ttf",
              "./assets/fonts/Unbounded_800ExtraBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Inter_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Unbounded",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Unbounded_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Unbounded_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Unbounded_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "457f4a56-1846-4d51-8a65-63d941486402"
      }
    },
    "owner": "eco1453"
  }
}
